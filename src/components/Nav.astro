---
import Logo from './Logo.astro';
import Sun from './icons/Sun.astro';
import HamburgerMenu from './icons/HamburgerMenu.astro';
import Button from './Button.astro';

/**
 * Top navigation. 1200 wide inside the 1440 frame, 24px of padding top and bottom
 * giving the drawn 84px height.
 *
 * The design deliberately strips the bottom border at 1440: the library component
 * draws a 0.5px rule, and that instance keeps the weight but removes the paint, so
 * no line renders. At 375 the rule IS painted, so it is drawn below lg only, as an
 * inset shadow rather than a border so it adds no height to the 72.
 *
 * The current page is signalled by full opacity plus a 0.5px underline; the other
 * links sit at 60% opacity. That is an instance override in the file rather than a
 * component state, so it is reproduced literally.
 *
 * No destination is specified for any nav item in the design, so hrefs point at
 * in-page anchors or are left off rather than invented.
 */
const links = [
  { label: 'Home', href: '/', current: true },
  { label: 'Slice', href: '#slice', current: false },
  { label: 'Blog', href: '#blog', current: false },
  { label: 'Docs', href: '#docs', current: false },
];
---

<nav
  class="mx-auto flex w-full max-w-[1200px] items-center justify-between px-6 py-4 shadow-[inset_0_-0.5px_0_0_var(--color-border-default)] lg:py-6 lg:shadow-none xl:px-0"
>
  <div class="flex items-center gap-12">
    <a
      href="/"
      class="text-body-default focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
      aria-label="DMND home"
    >
      <Logo width={64} height={27} />
    </a>
    <div class="hidden items-center gap-12 lg:flex">
      {
        links.map((l) => (
          <Button
            variant="tertiary"
            size="default"
            href={l.href}
            link={l.current}
            dim={!l.current}
            label={l.label}
            aria-current={l.current ? 'page' : undefined}
          />
        ))
      }
    </div>
  </div>

  {/* Desktop actions */}
  <div class="hidden items-center gap-4 lg:flex">
    <button
      type="button"
      aria-label="Switch theme"
      class="text-icon-alt transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
    >
      <Sun />
    </button>
    <Button variant="tertiary" size="default" href="#signin" label="Sign in" />
    <Button variant="primary" size="small" href="#start" label="Start mining" />
  </div>

  {/* Mobile actions: the design pairs the theme toggle with a 40px dark menu pill */}
  <div class="flex items-center gap-4 lg:hidden">
    <button
      type="button"
      aria-label="Switch theme"
      class="text-icon-alt transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
    >
      <Sun />
    </button>
    <button
      type="button"
      aria-label="Open menu"
      class="flex size-10 items-center justify-center rounded-[32px] bg-btn-bg p-3 text-border-default transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
    >
      <HamburgerMenu />
    </button>
  </div>
</nav>
