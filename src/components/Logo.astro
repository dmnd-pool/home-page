---
/**
 * The DMND wordmark.
 *
 * The Figma export wraps the five letterforms in a luminance mask and a clipPath
 * that are both full-bounds no-ops, so they are dropped here. Ink is driven by
 * `currentColor` because the design uses the same artwork in two greys: #262626 in
 * the nav and #374151 in the footer.
 */
interface Props {
  width?: number;
  height?: number;
  class?: string;
}
const { width = 64, height = 27, class: className } = Astro.props;
