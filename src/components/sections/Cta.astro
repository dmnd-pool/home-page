---
import Button from '../Button.astro';
import ctaArt from '../../assets/art-cta-texture.png';
import ctaArtMobile from '../../assets/art-cta-texture-mobile.png';

/**
 * The closing call to action.
 *
 * This and the efficiency block are the only two sections on the primary
 * background, and this is the only one with a visible border on the section
 * itself -- a real hairline on all four sides, at both breakpoints.
 *
 * Figma exports the artwork pre-clipped to the region the section reveals, and
 * bakes its 50% opacity into the pixels, so each crop is placed at its exported
 * size and full opacity. Re-applying an opacity in CSS would halve it twice.
 * The two breakpoints reveal different regions of the same group -- 824x412 to
 * the right at 1440, 375x483 across the bottom at 375 -- so they are genuinely
 * different crops rather than one image scaled, and each is hidden at the other
 * size.
 *
 * At 375 the section grows to 799 with NO bottom padding: the artwork runs flush
 * to the bottom edge, and the 10px itemSpacing above it is the only gap in the
 * design that actually applies.
 *
 * Two values differ between breakpoints and are built as drawn: the headline's
 * second run is #262626 at 375 but #374151 at 1440, and "Join now" keeps the
 * library's radius-32 pill at 375 where desktop squares it.
 */
---

<section
  class="relative h-[799px] overflow-hidden bg-bg-primary shadow-[inset_0_0_0_0.5px_var(--color-border-default)] lg:h-[412px]"
>
  <img
    src={ctaArtMobile.src}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-[316px] left-0 h-[483px] w-[375px] max-w-none select-none lg:hidden"
  />
  <img
    src={ctaArt.src}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-[616px] hidden h-[412px] w-[824px] max-w-none select-none lg:block"
  />

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6 pt-20 pb-0 lg:py-30 xl:px-0">
    <div class="flex w-full max-w-[327px] flex-col gap-8 lg:max-w-[500px]">
      <h2 class="font-heading text-3xl font-semibold text-body-alt lg:text-4xl">
        Fair payouts. Full control. <span class="text-body-default lg:text-header-alt"
          >Stratum V2 starts here.</span
        >
      </h2>
      <div class="flex flex-col items-start gap-4 lg:flex-row lg:flex-wrap lg:items-center">
        <Button
          variant="primary"
          size="small"
          sizeLg="default"
          pillSm
          href="#start"
          label="Join now"
        />
        <Button
          variant="tertiary"
          size="small"
          sizeLg="default"
          href="#institutions"
          link
          label="Mining at institutional scale? Talk to us"
        />
      </div>
    </div>
  </div>
</section>
