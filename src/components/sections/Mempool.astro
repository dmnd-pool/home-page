---
import BrowserMock from '../BrowserMock.astro';

/**
 * Mempool acceleration.
 *
 * A rail of five labels beside a column of five cards. The column is a SCROLL
 * REGION at BOTH sizes: the design marks it `overflowDirection: VERTICAL`, and it
 * holds far more card than the 484px viewport shows, so the reader scrolls it to
 * walk the five capabilities. Scroll chaining is left at its default, which is
 * what carries the page onward once the last card is reached.
 *
 * The rail turns: 282 wide down the left side at 1440, 604 wide across the top at
 * 375. Its items hug their labels there instead of filling a fixed width, which
 * is why no width is set on them below lg.
 *
 * The scrollbar is hidden because the design draws none, and a classic 15px
 * scrollbar would eat into the column and shift every mockup. The region stays
 * keyboard-scrollable via tabindex, which is the part that would otherwise be
 * lost with the scrollbar.
 *
 * At 375 the whole block is 604 wide inside a 375 section, so the section clips
 * 245 off the right and 128 off the bottom. That is what the frame draws, and it
 * leaves the last two rail labels outside the viewport.
 *
 * The mockups stop alternating left/right at 375: every one sits at the left of
 * its card, and card 5's starts 19px higher than the rest.
 */
const rail = [
  { label: 'MEMPOOL', active: true },
  { label: 'AUDITING', active: false },
  { label: 'SIGNALING', active: false },
  { label: 'MERGE MINING', active: false },
  { label: 'BLOCK', active: false },
];

const cards = [
  {
    title: 'Mempool acceleration',
    body: 'Extra fee rewards via transaction acceleration.',
    mockRight: true,
    mLeft: 24,
    mTop: 152,
    tone: 'light' as const,
    highlight: 'tile-1' as const,
  },
  {
    title: 'Share auditing',
    body: "Full SV2 transparency — audit every share; pool rate can't be inflated.",
    mockRight: false,
    mLeft: 22,
    mTop: 152,
    tone: 'default' as const,
    highlight: 'tile-2' as const,
  },
  {
    title: 'BIPs signaling',
    body: 'Signal for any BIP straight from your own template.',
    mockRight: true,
    mLeft: 22,
    mTop: 152,
    tone: 'default' as const,
    highlight: 'tile-3' as const,
  },
  {
    title: 'Merge mining & side-chain expansion',
    body: "Rootstock (RSK) rewards land in your wallet, not the pool's, plus side chains beyond RSK.",
    mockRight: false,
    mLeft: 22,
    mTop: 152,
    tone: 'default' as const,
    highlight: 'side-1' as const,
  },
  {
    // The design styles "mempool.space" blue and underlined but attaches no
    // destination, so it is drawn to match and left as text.
    title: 'Block stamping',
    body: 'Dedicated, branded blocks visible on ',
    accent: 'mempool.space',
    bodyAfter: ', your stamp on-chain.',
    mockRight: true,
    mLeft: 22,
    mTop: 133,
    tone: 'default' as const,
    highlight: 'side-2' as const,
  },
];

const hair = 'var(--color-border-default)';
// Cards carry a hairline on all four sides; the rail's own rules are per-row.
const cardEdges = `inset 0.5px 0.5px 0 0 ${hair}, inset -0.5px -0.5px 0 0 ${hair}`;
---

<section class="relative h-[504px] overflow-hidden bg-bg-default lg:h-[600px]">
  <div
    class="absolute top-20 left-4 h-[552px] w-[604px] lg:inset-x-0 lg:top-0 lg:mx-auto lg:h-full lg:w-full lg:max-w-[1200px]"
  >
    {/* The rail: a horizontal strip above the cards at 375, a vertical column
        beside them from lg. Only the active row is filled and boxed. */}
    <div
      class="absolute top-0 left-0 flex w-[604px] shadow-[inset_0_0_0_0.5px_var(--color-border-default)] lg:top-[120px] lg:w-[282px] lg:flex-col lg:shadow-none"
    >
      {
        rail.map((r) => (
          <div
            class:list={[
              'relative flex items-center px-6 py-6 lg:h-[72px] lg:w-full lg:py-0',
              r.active && 'bg-bg-primary',
            ]}
            style={`box-shadow: inset 0.5px 0 0 0 ${hair}, inset 0 -0.5px 0 0 ${hair}${
              r.active ? `, inset 0 0.5px 0 0 ${hair}, inset -0.5px 0 0 0 ${hair}` : ''
            }`}
          >
            <span class="flex items-center gap-1">
              {r.active && (
                <span class="size-1.5 shrink-0 rounded-full bg-green-500" aria-hidden="true" />
              )}
              <span
                class:list={[
                  'text-sm whitespace-nowrap lg:text-base',
                  r.active ? 'text-body-default' : 'text-body-alt',
                ]}
              >
                {r.label}
              </span>
            </span>
          </div>
        ))
      }
    </div>

    {/* The cards, scrolling inside a 484px viewport at both sizes. */}
    <div
      role="region"
      aria-label="Mining capabilities"
      tabindex="0"
      class="absolute top-[68px] left-0 h-[484px] w-[343px] overflow-y-auto [scrollbar-width:none] lg:top-[120.18px] lg:left-[282px] lg:w-[918px] [&::-webkit-scrollbar]:hidden"
    >
      {
        cards.map((c, i) => (
          <div class:list={[i === cards.length - 1 && 'pb-[124px]']}>
            <div
              class:list={[
                'relative overflow-hidden lg:h-[360px]',
                i === cards.length - 1 ? 'h-[281px]' : 'h-[300px]',
              ]}
              style={`box-shadow: ${cardEdges}`}
            >
              <div class="flex flex-col justify-center px-6 py-6 lg:h-[104px] lg:py-0">
                <h3 class="font-heading text-xl leading-8 font-medium text-header-alt">{c.title}</h3>
                <p class="text-sm text-body-alt lg:text-base">
                  {c.body}
                  {c.accent && <span class="text-text-info underline">{c.accent}</span>}
                  {c.bodyAfter}
                </p>
              </div>
              <div
                class:list={[
                  'absolute lg:static lg:mt-3 lg:flex',
                  c.mockRight && 'lg:justify-end',
                ]}
                style={`left:${c.mLeft}px; top:${c.mTop}px`}
              >
                <BrowserMock tone={c.tone} highlight={c.highlight} />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
