---
import Button from '../Button.astro';
import serverRack from '../../assets/art-server-rack.png';

/**
 * "You choose the block you mine. Not the pool."
 *
 * Two full-bleed hairlines bracket the section. The design stacks three identical
 * dividers at the top; only one is built.
 *
 * The inner 1042 column is centred inside the 1200 track, which means it overruns
 * the track's own 120 gutters by 41 on each side -- building it as padding would
 * be wrong. The 1200 track carries left and right hairlines of its own, in black
 * at 20% rather than the usual border grey.
 *
 * The heading's colour switch falls mid-line, so it cannot be built as two
 * coloured lines: it is one wrapping block at a fixed 352 with an inline span.
 * Widening that box moves the break.
 *
 * The artwork is a single-colour dot map at 60% group opacity, already baked into
 * the export. At 375 it is the same illustration at 0.8113x, so one export serves
 * both breakpoints; it stays in the flow there and sits flush to the left of the
 * column rather than beside the text.
 *
 * The heading tightens to 24/36 with -1 letter-spacing at 375, where desktop sets
 * 30/40 with none.
 */
---

<section class="relative overflow-hidden bg-bg-default px-6 py-20 lg:px-0 lg:py-2">
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-20 h-px bg-border-default/50 lg:top-2"
  ></span>

  <div
    class="mx-auto w-full max-w-[327px] px-3 shadow-[inset_0.5px_0_0_0_var(--color-btn-border),inset_-0.5px_0_0_0_var(--color-btn-border)] lg:max-w-[1200px] lg:px-6 xl:px-0"
  >
    <div
      class="mx-auto flex w-full max-w-[303px] flex-col items-start justify-between gap-[23px] py-16 lg:max-w-[1042px] lg:flex-row lg:items-center lg:gap-6"
    >
      <div class="flex flex-col gap-[23px]">
        <div class="flex flex-col gap-2">
          <h2 class="w-full font-heading text-2xl font-medium tracking-[-1px] text-body-alt lg:w-[352px] lg:text-3xl lg:tracking-normal">
            You choose the block you mine. <span class="text-header-default">Not the pool.</span>
          </h2>
          <p class="w-full max-w-[518px] text-base text-body-alt">
            Your current machines work here. Standard SV1 firmware connects through DMND&#39;s
            translation layer, no firmware changes required.
          </p>
        </div>
        <Button variant="primary" size="default" href="#node" label="Run your own node" />
      </div>

      <img
        src={serverRack.src}
        alt=""
        aria-hidden="true"
        width="331"
        height="296"
        class="pointer-events-none h-[240px] w-[268.54px] max-w-none shrink-0 select-none lg:h-[295.819px] lg:w-[331px]"
      />
    </div>
  </div>

  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-20 h-px bg-border-default/50 lg:bottom-2"
  ></span>
</section>
