---
import Tag from '../Tag.astro';

/**
 * "Block building via job declaration".
 *
 * A single bordered card split with space-between, so the real gap is 294 rather
 * than the stored 40 minimum. The left block is a fixed 377 even though its widest
 * child is 246 -- letting it hug would pull the subtitle 131px left of the design.
 *
 * The subtitle is the only right-aligned one on the page.
 *
 * The lower band is a diagonal hatch: 23 bars, each 125.44 x 2 in #E5E5E5, rotated
 * so they lean "/" and pitched 50.28 apart horizontally. They deliberately overrun
 * the band top and bottom and are clipped by it. Figma's rotation is
 * counter-clockwise-positive where CSS is clockwise-positive, so the file's +42.44
 * is written as -42.44 here; the lean is the same at both breakpoints.
 *
 * At 375 the card stacks instead of splitting, the subtitle goes back to LEFT
 * (it is the only right-aligned text on the page at 1440), and the band swaps
 * which three sides carry its hairline: left/top/right on desktop, left/bottom/
 * right on mobile. The hatch container also shifts, so the bars carry both
 * positions as custom properties.
 */
const bars = Array.from({ length: 23 }, (_, i) => i * (1106.084228515625 / 22));
---

<section class="overflow-hidden bg-bg-default px-4 py-20 lg:px-6 lg:py-30 xl:px-30">
  <div
    class="mx-auto w-full max-w-[343px] shadow-[inset_0_0_0_0.5px_var(--color-border-default)] lg:max-w-[1200px]"
  >
    <div class="flex flex-col justify-between gap-10 px-6 py-12 lg:flex-row lg:items-center lg:px-16">
      <div class="flex w-full flex-col gap-2 lg:w-[377px] lg:shrink-0">
        <Tag size="large" dot label="Foundation" class="self-start" />
        <h2 class="font-heading text-3xl font-medium text-body-alt">
          Block building <br /><span class="text-header-default">via job declaration</span>
        </h2>
      </div>

      <p class="w-full text-base text-body-alt lg:w-[401px] lg:text-right">
        Your template, built on your own node, the foundation every layer stands on.
      </p>
    </div>

    {/* The hatch band: bars are anchored to their own top-left and lean "/". */}
    <div
      class="relative h-12 overflow-hidden bg-bg-primary shadow-[inset_0.5px_0_0_0_var(--color-border-default),inset_-0.5px_0_0_0_var(--color-border-default),inset_0_-0.5px_0_0_var(--color-border-default)] lg:bg-transparent lg:shadow-[inset_0.5px_0.5px_0_0_var(--color-border-default),inset_-0.5px_0_0_0_var(--color-border-default)]"
    >
      {
        bars.map((x) => (
          <span
            aria-hidden="true"
            class="pointer-events-none absolute top-[var(--tm)] left-[var(--lm)] h-[2px] w-[125.43577575683594px] bg-bg-secondary lg:top-[var(--t)] lg:left-[var(--l)]"
            style={`--l:${x}px; --t:81.58717346191406px; --lm:${x - 428}px; --tm:65.58717346191406px; transform: rotate(-42.44245951954939deg); transform-origin: 0 0;`}
          />
        ))
      }
    </div>
  </div>
</section>
