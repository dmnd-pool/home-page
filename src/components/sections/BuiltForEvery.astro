---
import Button from '../Button.astro';

/**
 * "Built for every operation."
 *
 * Two columns split with space-between, so the real gap is 150 rather than the
 * stored 40 minimum. The right column is bottom-aligned against the left.
 *
 * The heading is one text node in two runs: an italic muted lead and a medium
 * dark payoff, broken by a U+2028 line separator that is reproduced as an
 * explicit break.
 *
 * Note the primary button also carries the design's Link flag, but that only
 * materialises an underline on the tertiary variant -- "Start mining" has none.
 *
 * At 375 the two columns stack and the button row becomes a button column. The
 * heading drops to 30/40.
 *
 * The mobile heading carries a designer artifact: the single space between the
 * two runs was left at 48/48 when the rest of the node was scaled to 30/40, which
 * inflates the drawn block to 91 instead of a clean 2 x 40. The same signature
 * appears on the hero H1 and the FAQ heading, so it reads as a scale-down
 * leftover rather than intent. Every run is built at the section's base size
 * here, which makes the block 80 rather than the drawn 91.
 */
---

<section class="overflow-hidden bg-bg-default px-4 py-20 lg:px-6 lg:py-30 xl:px-30">
  <div
    class="mx-auto flex w-full max-w-[343px] flex-col justify-between gap-6 lg:max-w-[1200px] lg:flex-row lg:gap-10"
  >
    <h2 class="font-heading text-3xl lg:w-[308px] lg:shrink-0 lg:text-5xl">
      <span class="font-normal italic text-body-alt">Built for</span><span
        class="font-medium text-header-default"
      > every <br />operation.</span>
    </h2>

    <div class="flex flex-col justify-end gap-6">
      <p class="w-full max-w-[742px] text-base text-body-alt">
        From institutional fleets to sovereign solo miners: SOC 2 Type II certified infrastructure,
        FPPS options, and dedicated support, with full control of your hashrate. Build your own block
        templates, verify every payout with SLICE, and connect over encrypted Stratum V2. Your node,
        your rules.
      </p>
      <div class="flex flex-col items-start gap-4 lg:flex-row lg:flex-wrap lg:items-center">
        <Button variant="primary" size="default" href="#start" label="Start mining" />
        <Button
          variant="tertiary"
          size="default"
          href="#institutions"
          link
          label="Mining at institutional scale? Talk to us"
        />
      </div>
    </div>
  </div>
</section>
