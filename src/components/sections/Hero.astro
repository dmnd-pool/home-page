---
import Tag from '../Tag.astro';
import Button from '../Button.astro';
import heroArt from '../../assets/art-hero-warehouse.png';
import heroArtMobile from '../../assets/art-hero-warehouse-mobile.png';

/**
 * Hero. The design draws a 1440x800 frame whose first child is the nav, so this
 * section covers the remaining 716 and every offset below is measured from the
 * nav's baseline rather than the frame's.
 *
 * The content block is two columns, not a stack: a 693-wide left column holding
 * the tag and headline, and a 483-wide right column holding the body copy and the
 * button row, bottom-aligned to each other with a 24px gap.
 *
 * The headline is one text node with two styled runs -- a muted lead and a darker
 * payoff -- broken by two U+2028 line separators and carrying a non-breaking space
 * before the last break. Those are reproduced as explicit breaks and an &nbsp;
 * rather than left to natural wrapping, because the design's line endings are
 * deliberate.
 *
 * The artwork is exported pre-clipped to the band the frame actually reveals, with
 * its 50% group opacity already baked in, so it is placed at full opacity. The two
 * breakpoints reveal DIFFERENT fractions of the same group -- the top 52.8% at
 * 1440 against 74.6% at 375 -- so the desktop file is missing pixels mobile needs
 * and each gets its own crop. Both sit flush to the bottom edge.
 *
 * At 375 the content is a single 347-wide column (an unusual 14px gutter, but that
 * is what centring a fixed 347 in 375 gives), the headline drops to 36/48, and the
 * badge keeps its pill while shrinking to the 12/16 ramp. The headline also loses
 * ONE of its two hard breaks there: the design keeps the separator after "mined"
 * but drops the one before "V2", so that break is desktop-only.
 *
 * This section switches at xl rather than lg because its two-column layout needs
 * the wider frame; the lg rules restore the intermediate single-column behaviour.
 */
---

<section
  class="relative h-[716px] overflow-hidden bg-bg-default lg:h-auto lg:min-h-[716px] lg:pb-[323px] xl:h-[716px] xl:pb-0"
>
  <div
    class="relative mx-auto flex w-full max-w-[1200px] flex-col gap-6 px-[14px] pt-16 lg:px-6 lg:pt-[120px] xl:absolute xl:inset-x-0 xl:top-[120px] xl:flex-row xl:items-end xl:px-0 xl:pt-0"
  >
    <div class="flex w-full flex-col gap-2 xl:w-[693px] xl:shrink-0">
      <Tag
        size="smallPill"
        sizeLg="large"
        dot
        label="Block 955,318 - the first SV2 block in Bitcoin history"
        class="self-start"
      />
      <h1 class="font-heading text-4xl tracking-normal lg:text-5xl">
        <span class="font-normal text-body-alt">The pool that mined <br />Bitcoin&#39;s</span><span
          class="font-medium text-header-alt"
        > first Stratum&nbsp;<br class="hidden lg:inline" />V2 block.</span>
      </h1>
    </div>

    <div class="flex flex-1 flex-col gap-6 xl:items-end">
      <p class="w-full text-base text-body-alt xl:w-[483px] xl:text-right">
        DMND is the first production Stratum V2 mining pool. Encrypted end-to-end, miner-built block
        templates, and payouts you can verify &#8212; up to 10% more efficient than legacy pools.
      </p>
      <div class="flex gap-2">
        <Button variant="primary" size="default" href="#start" label="Start mining" />
        <Button variant="secondary" size="default" href="#institutions" label="For institutions" />
      </div>
    </div>
  </div>

  <img
    src={heroArtMobile.src}
    alt=""
    aria-hidden="true"
    width="375"
    height="228"
    class="pointer-events-none absolute bottom-0 left-0 h-[228px] w-[375px] max-w-none select-none lg:hidden"
  />
  <img
    src={heroArt.src}
    alt=""
    aria-hidden="true"
    width="1031"
    height="323"
    class="pointer-events-none absolute bottom-0 left-0 hidden h-[323px] w-[1030.785px] max-w-none select-none lg:block"
  />
</section>
