---
import aerial from '../../assets/art-aerial-map.png';

/**
 * The Features / DMND / Legacy comparison table.
 *
 * The panel is opaque #fafafa and sits ON TOP of the dot-map, masking it: the
 * artwork only shows in the margins around the panel, not behind the table.
 *
 * The border grid is drawn by ownership rather than by giving every cell a full
 * box: column 1 owns the first seam on its right, column 3 owns the second on its
 * left, row 1 owns the rule under the header, and rows 1-3 own their own bottom
 * rules. Nothing is drawn twice, and there is no rule above the header or below
 * the last row. That scheme is identical at both breakpoints.
 *
 * The eight dots sit on the two vertical seams at each row boundary, painted over
 * the rules. The mobile frame lands them exactly on the seams; the desktop frame
 * is half a pixel out in places and its two header dots sit 1px apart from each
 * other, so each breakpoint keeps its own drawn positions.
 *
 * The table does NOT reflow at 375: no stacking, no horizontal scroll. It shrinks
 * instead -- unequal columns, tighter cells, a smaller type ramp, and a hard line
 * break baked into eleven of the fifteen strings. The header even changes family,
 * from Radio Canada Big to Geist.
 *
 * Both children of the mobile section are absolutely positioned, so its padding
 * and itemSpacing are inert and the frame simply renders 484 tall.
 *
 * The artwork's 50% group opacity is already baked into the exported pixels --
 * Figma composited it against the background, so the file is fully opaque and the
 * blend is in the RGB. Re-applying an opacity in CSS would halve it twice.
 */
const headers = ['Features', 'DMND', 'Legacy'];

// "|" marks the U+2028 the design bakes in at 375 only; it becomes a break that
// is hidden from lg up, where every one of these sets on a single line.
const rows = [
  ['Block |template', "Built on the |miner's own node", 'Built and controlled |by the pool'],
  ['Transaction |security', 'Binary, AEAD/|Noise-encrypted', 'Unencrypted |JSON-RPC'],
  ['Auditability', 'On-chain, verifiable |every share', 'Opaque, pool-run |dashboards'],
  ['Censorship |risk', 'Structurally impossible |to censor', 'Pool is legally |compellable'],
];

const colWidth = ['w-[85px]', 'w-[138px]', 'w-[126px]'];

// Desktop dots: row boundaries and the two seams, in section coordinates.
const dotRows = [185.875, 257.875, 329.875, 401.875];
// Mobile dots: seams at 89 and 227, boundaries at 52/116/180/244, grid-relative.
const mDotRows = [52, 116, 180, 244];
---

<section class="relative h-[484px] overflow-hidden bg-bg-default lg:h-[585px]">
  <img
    src={aerial.src}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-[-41.34px] left-0 h-[566px] w-[1005.69px] max-w-none select-none lg:inset-0 lg:h-full lg:w-full lg:object-cover"
  />

  <div
    class="absolute top-[80px] left-[9px] h-[308px] w-[357px] overflow-hidden bg-bg-default lg:inset-x-0 lg:top-[68.1875px] lg:mx-auto lg:h-[448px] lg:w-full lg:max-w-[1200px] lg:p-10"
  >
    <div class="relative flex h-[308px] w-[357px] lg:h-[368px] lg:w-[1120px]">
      {
        [0, 1, 2].map((col) => (
          <div class:list={['flex flex-col', colWidth[col], 'lg:w-auto lg:flex-1']}>
            {/* header cell: 52 tall on mobile, 80 from lg, top-aligned */}
            <div
              class:list={[
                'flex h-[52px] flex-col gap-1 px-2 py-4 lg:h-20 lg:p-6',
                col === 0 && 'border-r-[0.5px] border-border-default/50',
                col === 2 && 'border-l-[0.5px] border-border-default/50',
              ]}
            >
              <span
                class:list={[
                  'text-sm font-medium lg:font-heading lg:text-xl lg:leading-8',
                  col === 0 ? 'text-body-alt' : 'text-header-default',
                ]}
              >
                {headers[col]}
              </span>
            </div>

            {rows.map((r, i) => (
              <div
                class:list={[
                  'flex h-16 flex-col justify-center gap-1 px-2 py-4 lg:h-18 lg:p-6',
                  col === 0 && 'border-r-[0.5px] border-border-default/50',
                  col === 2 && 'border-l-[0.5px] border-border-default/50',
                  i === 0 && 'border-t-[0.5px] border-border-default/50',
                  i < 3 && 'border-b-[0.5px] border-border-default/50',
                ]}
              >
                <span
                  class:list={[
                    'text-xs lg:text-base',
                    col === 0 ? 'text-body-alt' : 'text-body-default',
                  ]}
                >
                  {r[col].split('|').map((part, n) => (
                    <>
                      {n > 0 && <br class="lg:hidden" />}
                      {part}
                    </>
                  ))}
                </span>
              </div>
            ))}
          </div>
        ))
      }

      {/* Seam dots, painted over the rules. */}
      {
        mDotRows.map((y) =>
          [89, 227].map((x) => (
            <span
              aria-hidden="true"
              class="pointer-events-none absolute size-1 rounded-full bg-icon-alt lg:hidden"
              style={`left:${x - 2}px; top:${y - 2}px`}
            />
          )),
        )
      }
      {
        dotRows.map((y) =>
          [531, 905].map((x) => (
            <span
              aria-hidden="true"
              class="pointer-events-none absolute hidden size-1 rounded-full bg-icon-alt lg:block"
              style={`left:${x - 160}px; top:${y - 108.1875}px`}
            />
          )),
        )
      }
    </div>
  </div>
</section>
