---
import '../styles/global.css';

/**
 * The page shell. Meta defaults mirror the live dmnd.work so the redesign does not
 * regress the site's existing search presence.
 */
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DMND — The world's first Stratum V2 mining pool",
  description = 'DMND is the first production Stratum V2 mining pool. Encrypted end-to-end, miner-built block templates, and payouts you can verify.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
