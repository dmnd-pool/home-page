---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Stats from '../components/sections/Stats.astro';
import Efficiency from '../components/sections/Efficiency.astro';
import BuiltForEvery from '../components/sections/BuiltForEvery.astro';
import ChooseYourBlock from '../components/sections/ChooseYourBlock.astro';
import Mempool from '../components/sections/Mempool.astro';
import BlockBuilding from '../components/sections/BlockBuilding.astro';
import Slice from '../components/sections/Slice.astro';
import Dashboard from '../components/sections/Dashboard.astro';
import Comparison from '../components/sections/Comparison.astro';
import Faq from '../components/sections/Faq.astro';
import Blog from '../components/sections/Blog.astro';
import Cta from '../components/sections/Cta.astro';
import FeaturedIn from '../components/sections/FeaturedIn.astro';
import Footer from '../components/Footer.astro';

/**
 * The landing page. Sections butt flush against each other -- the design frame is a
 * vertical stack with itemSpacing 0, so all vertical rhythm lives in each section's
 * own padding rather than in a gap between them.
 *
 * Sections are added one phase at a time; the nav and footer land first because
 * every later section sits between them.
 */
---

<Base>
  <!-- The nav sits inside the hero section in the design, not above it. -->
  <header class="bg-bg-default pt-6 lg:pt-0">
    <Nav />
  </header>

  <main>
    <Hero />
    <Stats />
    <Efficiency />
    <BuiltForEvery />
    <ChooseYourBlock />
    <Mempool />
    <BlockBuilding />
    <Comparison />
    <Slice />
    <Dashboard />
    <FeaturedIn />
    <Faq />
    <Blog />
    <Cta />
  </main>

  <Footer />
</Base>
